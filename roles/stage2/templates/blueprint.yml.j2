# Stage 2 blueprint for {{ lab_name }}, generated by LabBuilder (roles/stage2).
# Run inside the lab, on the Ansible VM, against the lab's own vCenter:
#   ansible-playbook main.yml -i inventories/stage2.yml -e mainvars=vars/stage2.yml -e credentials=vars/stage2-credentials.yml
all:
  vars:
    lab_name: {{ lab_name }}_stage2
    lab_prefix: ""
    lab_password: "{{ '{{ default_lab_password }}' }}"
    lab_vm_datastore: {{ stage2_datastore }}
  children:
    vsphere_prep:
      hosts:
        {{ stage2_vcenter }}:
          esx_hosts:
{% for h in stage2_esx_hosts %}
            - {{ h }}.{{ lab_domain_name }}
{% endfor %}
          isos: {{ stage2_isos | to_json }}
{% if stage2_ovas %}
    ovf:
      hosts:
{% for o in stage2_ovas %}
        {{ o.name }}:
          ovf_file: {{ ('files/' ~ o.name ~ '-ovf/' ~ o.name ~ '.ovf') if o.fix_ovf | default(false) else ('files/' ~ o.ova) }}
          ovf_networks: {{ o.networks | default({'VM Network': stage2_network}) | to_json }}
          ovf_properties: {{ o.properties | default({}) | to_json }}
{% endfor %}
{% endif %}
