# Stage 2 vars for {{ lab_name }}, generated by LabBuilder (roles/stage2): the lab's own vCenter.
vcenter_address: {{ hostvars[stage2_vcenter].ip_address }}
vcenter_username: administrator@vsphere.local
vcenter_password: "{{ '{{ default_lab_password }}' }}"
vcenter_datacenter: {{ stage2_datacenter }}
vcenter_cluster: {{ stage2_cluster }}
esxi_username: root
esxi_password: "{{ '{{ default_lab_password }}' }}"
vm_datastore: {{ stage2_datastore }}
iso_datastore: {{ stage2_datastore }}
vm_network: "{{ stage2_network }}"
