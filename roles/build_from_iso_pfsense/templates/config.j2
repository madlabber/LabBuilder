<?xml version="1.0"?>
<pfsense>
	<version>23.3</version>
	<lastchange></lastchange>
	<system>
		<optimization>normal</optimization>
		<hostname>{{ vm_hostname | default('pfsense') }}</hostname>
		<domain>{{ lan.domain | default('home.arpa') }}</domain>
		<dnsallowoverride></dnsallowoverride>
		<group>
			<name>all</name>
			<description><![CDATA[All Users]]></description>
			<scope>system</scope>
			<gid>1998</gid>
			<member>0</member>
		</group>
		<group>
			<name>admins</name>
			<description><![CDATA[System Administrators]]></description>
			<scope>system</scope>
			<gid>1999</gid>
			<member>0</member>
			<priv>page-all</priv>
		</group>
		<user>
			<name>admin</name>
			<descr><![CDATA[System Administrator]]></descr>
			<scope>system</scope>
			<groupname>admins</groupname>
			<bcrypt-hash>{{ pfsense_hashed_password }}</bcrypt-hash>
			<uid>0</uid>
			<priv>user-shell-access</priv>
		</user>
		<nextuid>2000</nextuid>
		<nextgid>2000</nextgid>
		<timeservers>2.pfsense.pool.ntp.org</timeservers>
		<webgui>
			<protocol>https</protocol>
			<loginautocomplete></loginautocomplete>
			<ssl-certref>6acb1009afc3e</ssl-certref>
			<wizard>false</wizard>
		</webgui>
		<disablenatreflection>yes</disablenatreflection>
		<disablesegmentationoffloading></disablesegmentationoffloading>
		<disablelargereceiveoffloading></disablelargereceiveoffloading>
		<ipv6allow></ipv6allow>
		<maximumtableentries>400000</maximumtableentries>
		<powerd_ac_mode>hadp</powerd_ac_mode>
		<powerd_battery_mode>hadp</powerd_battery_mode>
		<powerd_normal_mode>hadp</powerd_normal_mode>
		<bogons>
			<interval>monthly</interval>
		</bogons>
		<hn_altq_enable></hn_altq_enable>
		<already_run_config_upgrade></already_run_config_upgrade>
		<ssh>
			<enable>enabled</enable>
		</ssh>
	</system>
	<interfaces>
		<wan>
			<enable></enable>
			<if>em0</if>
			<mtu></mtu>
			<ipaddr>dhcp</ipaddr>
			<ipaddrv6>dhcp6</ipaddrv6>
			<subnet></subnet>
			<gateway></gateway>
			<dhcphostname></dhcphostname>
			<media></media>
			<mediaopt></mediaopt>
			<dhcp6-duid></dhcp6-duid>
			<dhcp6-ia-pd-len>0</dhcp6-ia-pd-len>
		</wan>
		<lan>
			<enable></enable>
			<if>em1</if>
			<ipaddr>{{ lan.address | default('192.168.1.1') }}</ipaddr>
			<subnet>{{ lan.netmask_cidr | default('24') }}</subnet>
			<ipaddrv6>track6</ipaddrv6>
			<subnetv6>64</subnetv6>
			<media></media>
			<mediaopt></mediaopt>
			<track6-interface>wan</track6-interface>
			<track6-prefix-id>0</track6-prefix-id>
		</lan>
{% if opt1.address is defined %}
		<opt1>
			<enable></enable>
			<if>em2</if>
			<ipaddr>{{ opt1.address | default('192.168.10.1') }}</ipaddr>
			<subnet>{{ opt1.netmask_cidr | default('24') }}</subnet>
			<ipaddrv6>track6</ipaddrv6>
			<subnetv6>64</subnetv6>
			<media></media>
			<mediaopt></mediaopt>
			<track6-interface>wan</track6-interface>
			<track6-prefix-id>0</track6-prefix-id>
		</opt1>
{% endif %}
{% if opt2.address is defined %}
		<opt2>
			<enable></enable>
			<if>em3</if>
			<ipaddr>{{ opt2.address | default('192.168.20.1') }}</ipaddr>
			<subnet>{{ opt2.netmask_cidr | default('24') }}</subnet>
			<ipaddrv6>track6</ipaddrv6>
			<subnetv6>64</subnetv6>
			<media></media>
			<mediaopt></mediaopt>
			<track6-interface>wan</track6-interface>
			<track6-prefix-id>0</track6-prefix-id>
		</opt2>
{% endif %}
{% if opt3.address is defined %}
		<opt3>
			<enable></enable>
			<if>em4</if>
			<ipaddr>{{ opt3.address | default('192.168.30.1') }}</ipaddr>
			<subnet>{{ opt3.netmask_cidr | default('24') }}</subnet>
			<ipaddrv6>track6</ipaddrv6>
			<subnetv6>64</subnetv6>
			<media></media>
			<mediaopt></mediaopt>
			<track6-interface>wan</track6-interface>
			<track6-prefix-id>0</track6-prefix-id>
		</opt3>
{% endif %}
{% if opt4.address is defined %}
		<opt4>
			<enable></enable>
			<if>em5</if>
			<ipaddr>{{ opt4.address | default('192.168.40.1') }}</ipaddr>
			<subnet>{{ opt4.netmask_cidr | default('24') }}</subnet>
			<ipaddrv6>track6</ipaddrv6>
			<subnetv6>64</subnetv6>
			<media></media>
			<mediaopt></mediaopt>
			<track6-interface>wan</track6-interface>
			<track6-prefix-id>0</track6-prefix-id>
		</opt4>
{% endif %}
{% if opt5.address is defined %}
		<opt5>
			<enable></enable>
			<if>em6</if>
			<ipaddr>{{ opt5.address | default('192.168.50.1') }}</ipaddr>
			<subnet>{{ opt5.netmask_cidr | default('24') }}</subnet>
			<ipaddrv6>track6</ipaddrv6>
			<subnetv6>64</subnetv6>
			<media></media>
			<mediaopt></mediaopt>
			<track6-interface>wan</track6-interface>
			<track6-prefix-id>0</track6-prefix-id>
		</opt5>
{% endif %}
{% if opt6.address is defined %}
		<opt6>
			<enable></enable>
			<if>em7</if>
			<ipaddr>{{ opt6.address | default('192.168.60.1') }}</ipaddr>
			<subnet>{{ opt6.netmask_cidr | default('24') }}</subnet>
			<ipaddrv6>track6</ipaddrv6>
			<subnetv6>64</subnetv6>
			<media></media>
			<mediaopt></mediaopt>
			<track6-interface>wan</track6-interface>
			<track6-prefix-id>0</track6-prefix-id>
		</opt6>
{% endif %}
	</interfaces>
	<staticroutes>
	</staticroutes>
	<dhcpd>
{% if lan.dhcp_start is defined and lan.dhcp_end is defined and lan.address is defined %}
		<lan>
			<enable></enable>
			<range>
				<from>{{ lan.dhcp_start }}</from>
				<to>{{ lan.dhcp_end }}</to>
			</range>
			<gateway>{{ lan.address }}</gateway>
		</lan>
{% endif %}
{% if opt1.dhcp_start is defined and opt1.dhcp_end is defined and opt1.address is defined %}
		<opt1>
			<enable></enable>
			<range>
				<from>{{ opt1.dhcp_start }}</from>
				<to>{{ opt1.dhcp_end }}</to>
			</range>
			<gateway>{{ opt1.address }}</gateway>
		</opt1>
{% endif %}
{% if opt2.dhcp_start is defined and opt2.dhcp_end is defined and opt2.address is defined %}
		<opt2>
			<enable></enable>
			<range>
				<from>{{ opt2.dhcp_start }}</from>
				<to>{{ opt2.dhcp_end }}</to>
			</range>
			<gateway>{{ opt2.address }}</gateway>
		</opt2>
{% endif %}
{% if opt3.dhcp_start is defined and opt3.dhcp_end is defined and opt3.address is defined %}
		<opt3>
			<enable></enable>
			<range>
				<from>{{ opt3.dhcp_start }}</from>
				<to>{{ opt3.dhcp_end }}</to>
			</range>
			<gateway>{{ opt3.address }}</gateway>
		</opt3>
{% endif %}
{% if opt4.dhcp_start is defined and opt4.dhcp_end is defined and opt4.address is defined %}
		<opt4>
			<enable></enable>
			<range>
				<from>{{ opt4.dhcp_start }}</from>
				<to>{{ opt4.dhcp_end }}</to>
			</range>
			<gateway>{{ opt4.address }}</gateway>
		</opt4>
{% endif %}
{% if opt5.dhcp_start is defined and opt5.dhcp_end is defined and opt5.address is defined %}
		<opt5>
			<enable></enable>
			<range>
				<from>{{ opt5.dhcp_start }}</from>
				<to>{{ opt5.dhcp_end }}</to>
			</range>
			<gateway>{{ opt5.address }}</gateway>
		</opt5>
{% endif %}
{% if opt6.dhcp_start is defined and opt6.dhcp_end is defined and opt6.address is defined %}
		<opt6>
			<enable></enable>
			<range>
				<from>{{ opt6.dhcp_start }}</from>
				<to>{{ opt6.dhcp_end }}</to>
			</range>
			<gateway>{{ opt6.address }}</gateway>
		</opt6>
{% endif %}
	</dhcpd>
	<dhcpdv6>
		<lan>
			<enable></enable>
			<range>
				<from>::1000</from>
				<to>::2000</to>
			</range>
			<ramode>assist</ramode>
			<rapriority>medium</rapriority>
		</lan>
	</dhcpdv6>
	<snmpd>
		<syslocation></syslocation>
		<syscontact></syscontact>
		<rocommunity>public</rocommunity>
	</snmpd>
	<diag>
		<ipv6nat>
			<ipaddr></ipaddr>
		</ipv6nat>
	</diag>
	<syslog>
		<filterdescriptions>1</filterdescriptions>
	</syslog>
	<nat>
		<outbound>
			<mode>automatic</mode>
		</outbound>
		{% if nat_rules is defined %}
		{% for rule in nat_rules %}
		<rule>
			<source>
				<any></any>
			</source>
			<destination>
				<network>wanip</network>
				<port>{{ rule.external_port }}</port>
			</destination>
			<ipprotocol>inet</ipprotocol>
			<protocol>{{ rule.protocol | default('tcp') }}</protocol>
			<target>{{ rule.target_ip }}</target>
			<local-port>{{ rule.internal_port }}</local-port>
			<interface>wan</interface>
			<descr><![CDATA[{{ rule.name }}]]></descr>
			<associated-rule-id>pass</associated-rule-id>
		</rule>
		{% endfor %}
		{% endif %}
	</nat>
	<filter>
		<rule>
		    <id></id>
			<type>pass</type>
			<ipprotocol>inet46</ipprotocol>
			<descr></descr>
			<interface>lan</interface>
			<tracker>0100000101</tracker>
			<source>
				<any></any>
			</source>
			<destination>
				<any></any>
			</destination>
		</rule>
{% if opt1.address is defined %}
		<rule>
		    <id></id>
			<type>pass</type>
			<ipprotocol>inet46</ipprotocol>
			<descr></descr>
			<interface>opt1</interface>
			<tracker>0100000201</tracker>
			<source>
				<any></any>
			</source>
			<destination>
				<any></any>
			</destination>
		</rule>
{% endif %}
{% if opt2.address is defined %}
		<rule>
			<type>pass</type>
			<ipprotocol>inet46</ipprotocol>
			<descr></descr>
			<interface>opt2</interface>
			<tracker>0100000301</tracker>
			<source>
				<any></any>
			</source>
			<destination>
				<any></any>
			</destination>
		</rule>
{% endif %}
{% if opt3.address is defined %}
		<rule>
			<type>pass</type>
			<ipprotocol>inet46</ipprotocol>
			<descr></descr>
			<interface>opt3</interface>
			<tracker>0100000401</tracker>
			<source>
				<any></any>
			</source>
			<destination>
				<any></any>
			</destination>
		</rule>
{% endif %}
{% if opt4.address is defined %}
		<rule>
			<type>pass</type>
			<ipprotocol>inet46</ipprotocol>
			<descr></descr>
			<interface>opt4</interface>
			<tracker>0100000501</tracker>
			<source>
				<any></any>
			</source>
			<destination>
				<any></any>
			</destination>
		</rule>
{% endif %}
{% if opt5.address is defined %}
		<rule>
			<type>pass</type>
			<ipprotocol>inet46</ipprotocol>
			<descr></descr>
			<interface>opt5</interface>
			<tracker>0100000601</tracker>
			<source>
				<any></any>
			</source>
			<destination>
				<any></any>
			</destination>
		</rule>
{% endif %}
{% if opt6.address is defined %}
		<rule>
			<type>pass</type>
			<ipprotocol>inet46</ipprotocol>
			<descr></descr>
			<interface>opt6</interface>
			<tracker>0100000701</tracker>
			<source>
				<any></any>
			</source>
			<destination>
				<any></any>
			</destination>
		</rule>
{% endif %}
		<separator>
		</separator>
	</filter>
	<shaper>
	</shaper>
	<ipsec>
		<client></client>
	</ipsec>
	<aliases>
	</aliases>
	<proxyarp></proxyarp>
	<cron>
		<item>
			<minute>*/1</minute>
			<hour>*</hour>
			<mday>*</mday>
			<month>*</month>
			<wday>*</wday>
			<who>root</who>
			<command>/usr/sbin/newsyslog</command>
		</item>
		<item>
			<minute>1</minute>
			<hour>3</hour>
			<mday>*</mday>
			<month>*</month>
			<wday>*</wday>
			<who>root</who>
			<command>/etc/rc.periodic daily</command>
		</item>
		<item>
			<minute>15</minute>
			<hour>4</hour>
			<mday>*</mday>
			<month>*</month>
			<wday>6</wday>
			<who>root</who>
			<command>/etc/rc.periodic weekly</command>
		</item>
		<item>
			<minute>30</minute>
			<hour>5</hour>
			<mday>1</mday>
			<month>*</month>
			<wday>*</wday>
			<who>root</who>
			<command>/etc/rc.periodic monthly</command>
		</item>
		<item>
			<minute>1,31</minute>
			<hour>0-5</hour>
			<mday>*</mday>
			<month>*</month>
			<wday>*</wday>
			<who>root</who>
			<command>/usr/bin/nice -n20 adjkerntz -a</command>
		</item>
		<item>
			<minute>1</minute>
			<hour>3</hour>
			<mday>1</mday>
			<month>*</month>
			<wday>*</wday>
			<who>root</who>
			<command>/usr/bin/nice -n20 /etc/rc.update_bogons.sh</command>
		</item>
		<item>
			<minute>1</minute>
			<hour>1</hour>
			<mday>*</mday>
			<month>*</month>
			<wday>*</wday>
			<who>root</who>
			<command>/usr/bin/nice -n20 /etc/rc.dyndns.update</command>
		</item>
		<item>
			<minute>*/60</minute>
			<hour>*</hour>
			<mday>*</mday>
			<month>*</month>
			<wday>*</wday>
			<who>root</who>
			<command>/usr/bin/nice -n20 /usr/local/sbin/expiretable -v -t 3600 virusprot</command>
		</item>
		<item>
			<minute>30</minute>
			<hour>12</hour>
			<mday>*</mday>
			<month>*</month>
			<wday>*</wday>
			<who>root</who>
			<command>/usr/bin/nice -n20 /etc/rc.update_urltables</command>
		</item>
		<item>
			<minute>1</minute>
			<hour>0</hour>
			<mday>*</mday>
			<month>*</month>
			<wday>*</wday>
			<who>root</who>
			<command>/usr/bin/nice -n20 /etc/rc.update_pkg_metadata</command>
		</item>
	</cron>
	<wol></wol>
	<rrd>
		<enable></enable>
	</rrd>
	<widgets>
		<sequence>system_information:col1:show,disks:col1:show,netgate_services_and_support:col2:show,interfaces:col2:show</sequence>
		<period>10</period>
	</widgets>
	<openvpn>
	</openvpn>
	<dnshaper>
	</dnshaper>
	<unbound>
		<enable></enable>
		<dnssec></dnssec>
		<active_interface></active_interface>
		<outgoing_interface></outgoing_interface>
		<custom_options></custom_options>
		
		<hideversion></hideversion>
		<dnssecstripped></dnssecstripped>
		{% if dns_acls is defined %}
		<acls>
			{% for acl in dns_acls %}
			<aclid>{{ loop.index0 }}</aclid>
			<aclname><![CDATA[{{ acl.name }}]]></aclname>
			<aclaction>{{ acl.action }}</aclaction>
			<description></description>
			<row>
				<acl_network>{{ acl.network }}</acl_network>
				<mask>{{ acl.mask }}</mask>
				<description><![CDATA[{{ acl.row_desc }}]]></description>
			</row>
			{% endfor %}
		</acls>
		{% endif %}
		{% if dns_overrides is defined %}
		{% for override in dns_overrides %}
		<domainoverrides>
			<domain>{{ override.domain }}</domain>
			<ip>{{ override.target_ip }}</ip>
			<descr><![CDATA[{{ override.desc }}]]></descr>
		</domainoverrides>
		{% endfor %}
		{% endif %}
	</unbound>
	<vlans>
	</vlans>
	<qinqs>
	</qinqs>
	<revision>
		<time>1791692810</time>
		<description><![CDATA[(system): Rendered dynamically via Ansible Task Loop]]></description>
		<username><![CDATA[(system)]]></username>
	</revision>
	<gateways>
	</gateways>
	<captiveportal></captiveportal>
	<dnsmasq></dnsmasq>
	<ntpd>
		<gps></gps>
	</ntpd>
	<cert>
		<refid>6acb1009afc3e</refid>
		<descr><![CDATA[GUI default (6acb1009afc3e)]]></descr>
		<type>server</type>
		<crt></crt>
	</cert>
{% if host_type is defined and host_type == "vmw" %}
	<installedpackages>
		<service>
			<name>vmware-guestd</name>
			<rcfile>vmware-guestd.sh</rcfile>
			<custom_php_service_status_command>mwexec(&quot;/usr/local/etc/rc.d/vmware-guestd status&quot;) == 0;</custom_php_service_status_command>
			<description><![CDATA[VMware Guest Daemon]]></description>
		</service>
		<service>
			<name>vmware-kmod</name>
			<rcfile>vmware-kmod.sh</rcfile>
			<custom_php_service_status_command>mwexec(&quot;/usr/local/etc/rc.d/vmware-kmod status&quot;) == 0;</custom_php_service_status_command>
			<description><![CDATA[VMware Kernel Modules]]></description>
		</service>
		<package>
			<name>Open-VM-Tools</name>
			<descr><![CDATA[VMware Tools is a suite of utilities that enhances the performance of the virtual machine's guest operating system and improves management of the virtual machine.]]></descr>
			<website>http://open-vm-tools.sourceforge.net/</website>
			<version>10.1.0_5,1</version>
			<pkginfolink>https://docs.netgate.com/pfsense/en/latest/packages/open-vm-tools.html</pkginfolink>
			<configurationfile>open-vm-tools.xml</configurationfile>
			<logging>
				<logfilename>vmware-vmsvc-root.log</logfilename>
			</logging>
			<include_file>/usr/local/pkg/open-vm-tools.inc</include_file>
		</package>
	</installedpackages>
	{% endif %}
</pfsense>
